PORT=3011
DATA_STORE=memory            # memory | supabase
ADMIN_USERNAME=admin
ADMIN_PASSWORD=sipkak-admin
ADMIN_SESSION_SECRET=replace-with-a-random-long-secret
# For multiple admins instead of ADMIN_USERNAME / ADMIN_PASSWORD, uncomment and edit:
# ADMIN_USERS_JSON=[{"username":"admin1","password":"replace-this"},{"username":"admin2","password":"replace-this-too"}]
SUPABASE_URL=                # phase 4, e.g. https://xxxx.supabase.co
SUPABASE_SECRET_KEY=         # phase 4, sb_secret_… (server only, never in the frontend)

# Required only when DATA_STORE=supabase; generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=
